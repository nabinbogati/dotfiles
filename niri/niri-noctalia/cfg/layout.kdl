    layout {
        gaps 8 // Gap between windows
        center-focused-column "never" // Don’t auto-center focused column

        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

        focus-ring {
          width 3
          active-color "#cba6f7"
          inactive-color "#505050"
        }

        border {
          off
          active-color "#ffc87f"
          inactive-color "#505050"
        }

        struts {}
    }
